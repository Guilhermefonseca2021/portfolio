{
  "compilerOptions": {
    "composite": true,

    "target": "ES2023",
    "lib": ["ES2023"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "types": ["node"],

    "strict": true,

    "skipLibCheck": true,

    "noEmit": true
  },

  "include": ["vite.config.ts"]
}
